# ───────── مصدر المحتوى: Google Drive ─────────
# معرّف المجلد الرئيسي لملف الإنجاز (من رابط المجلد)
DRIVE_ROOT_FOLDER_ID=17rtgy8oaRNnS27bjsL0u5-bcjD1xbEXS

# الطريقة (أ) — الأسهل: مفتاح Google API، ويقرأ الملفات المشاركة بخيار "أي شخص لديه الرابط" فقط
GOOGLE_API_KEY=

# الطريقة (ب) — حساب خدمة (Service Account): شاركي المجلد معه كـ"مُشاهِد".
# تظهر للزوار فقط الملفات المشاركة بالرابط، وتظهر بقية الملفات في لوحة التحكم وحدها.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ───────── لوحة التحكم ─────────
ADMIN_PASSWORD=
# سلسلة عشوائية طويلة (32 حرفًا أو أكثر) لتوقيع جلسة الدخول
ADMIN_SESSION_SECRET=

# ───────── حفظ إعدادات اللوحة (مطلوب على Vercel) ─────────
# Upstash Redis أو Vercel KV — أي منهما
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# رابط الموقع النهائي (لتحسين محركات البحث)
NEXT_PUBLIC_SITE_URL=https://afnan-portfolio.vercel.app
