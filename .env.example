# قاعدة البيانات PostgreSQL (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# كلمة مرور لوحة التحكم (اختاري كلمة قوية)
ADMIN_PASSWORD="change-me"

# مفتاح سري لتوقيع جلسة الإدارة (32 حرفًا عشوائيًا على الأقل)
AUTH_SECRET="replace-with-a-long-random-string"

# لرفع الملفات على Vercel: أنشئي Blob Store من لوحة Vercel وسيُضاف هذا المتغير تلقائيًا
BLOB_READ_WRITE_TOKEN=""

# رابط الموقع بعد النشر (لروابط المشاركة)
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"
